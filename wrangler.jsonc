{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simira-site",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-08-07",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public"
  }
}
