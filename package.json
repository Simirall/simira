{
  "name": "my-page-new",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "waku dev",
    "build": "waku build",
    "start": "wrangler dev --config dist/server/wrangler.json --local",
    "deploy": "pnpm run build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write ./src",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.13.14",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "waku": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
